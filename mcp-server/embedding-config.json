  "models": {
    "all-mpnet-base-v2": {
      "description": "Fast, balanced quality (recommended)",
      "dimensions": 768,
      "maxTokens": 384,
      "speed": "fast",
      "quality": "good"
    },
    "BAAI/bge-large-en-v1.5": {
      "description": "High quality, slower",
      "dimensions": 1024,
      "maxTokens": 512,
      "speed": "medium",
      "quality": "excellent"
    }
  }
}
